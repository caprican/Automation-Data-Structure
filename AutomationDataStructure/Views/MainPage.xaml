<Page x:Class="AutomationDataStructure.Views.MainPage"
      Style="{DynamicResource MahApps.Styles.Page}"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:controls="http://metro.mahapps.com/winfx/xaml/controls"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:converters="clr-namespace:AutomationDataStructure.Converters"
      xmlns:models="clr-namespace:AutomationDataStructure.Models"
      xmlns:properties="clr-namespace:AutomationDataStructure.Properties"
      xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
      xmlns:viewModels="clr-namespace:AutomationDataStructure.ViewModels"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance viewModels:MainViewModel}">

    <controls:MetroHeader Header="{Binding DeviceSource.Name}" Style="{StaticResource MahApps.Styles.MetroHeader}" Margin="{StaticResource XSmallMargin}">
        <controls:MetroHeader.HeaderTemplate>
            <DataTemplate>
                <StackPanel Orientation="Vertical" UseLayoutRounding="True">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                            <!--<ColumnDefinition Width="Auto"/>-->
                        </Grid.ColumnDefinitions>
                        <TextBlock Margin="{StaticResource XXSmallTopBottomMargin}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Text="{Binding}" />
                        <Button Grid.Column="2" Command="{Binding DataContext.ConvertCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                Style="{DynamicResource MahApps.Styles.Button.Flat.Accent}" Margin="{StaticResource XXSmallLeftRightMargin}">
                            <TextBlock Text="{x:Static properties:Resources.MainPageConvertButtomText}"/>
                        </Button>
                        <!--<Button Grid.Column="3" Command="{Binding DataContext.ExportCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                Style="{DynamicResource MahApps.Styles.Button.Flat.Accent}" Margin="{StaticResource XXSmallLeftRightMargin}">
                            <TextBlock Text="{x:Static properties:Resources.MainPageExportCommandText}"/>
                        </Button>-->
                    </Grid>
                    <Separator />
                </StackPanel>
            </DataTemplate>
        </controls:MetroHeader.HeaderTemplate>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="{x:Static properties:Resources.MainPageInputsText}" Style="{StaticResource SubtitleTextStyle}"
                           Margin="{StaticResource SmallMargin}"/>
                <ListView Grid.Row="1" ItemsSource="{Binding DeviceSource.Inputs}" Margin="{StaticResource SmallLeftRightMargin}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <!--<ColumnDefinition Width="50"/>-->
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding DataType}"/>
                                <!--<TextBlock Grid.Column="1" Text="{Binding Size}"/>-->
                                <TextBlock Grid.Column="1" Text="{Binding Name}"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock Grid.Row="2" Text="{x:Static properties:Resources.MainPageOutputsText}"  Style="{StaticResource SubtitleTextStyle}"
                           Margin="{StaticResource SmallMargin}"/>
                <ListView Grid.Row="3" ItemsSource="{Binding DeviceSource.Outputs}" Margin="{StaticResource SmallLeftRightMargin}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <!--<ColumnDefinition Width="50"/>-->
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding DataType}"/>
                                <!--<TextBlock Grid.Column="1" Text="{Binding Size}"/>-->
                                <TextBlock Grid.Column="1" Text="{Binding Name}"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <GridSplitter Grid.Column="1" Visibility="{Binding ConvertResultView}"/>

            <Grid Grid.Column="2" Visibility="{Binding ConvertResultView}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Static properties:Resources.MainPageDeviceDutText}" Style="{StaticResource SubtitleTextStyle}"/>
                    <Button Grid.Column="1" Command="{Binding CopyCommand}" CommandParameter="{Binding ConvertGvlResult}" Style="{StaticResource MahApps.Styles.Button.WindowCommands}">
                        <TextBlock Text="&#xE8C8;" FontSize="14" FontFamily="Segoe MDL2 Assets"/>
                    </Button>
                </Grid>
                <TextBox Grid.Row="1" Text="{Binding ConvertGvlResult, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MahApps.Styles.TextBox}"/>
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Static properties:Resources.MainPageInputDutText}" Style="{StaticResource SubtitleTextStyle}"/>
                    <Button Grid.Column="1" Command="{Binding CopyCommand}" CommandParameter="{Binding ConvertInputResult}" Style="{StaticResource MahApps.Styles.Button.WindowCommands}">
                        <TextBlock Text="&#xE8C8;" FontSize="14" FontFamily="Segoe MDL2 Assets"/>
                    </Button>
                </Grid>
                <TextBox Grid.Row="3" Text="{Binding ConvertInputResult, UpdateSourceTrigger=PropertyChanged}"/>
                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Static properties:Resources.MainPageOutputDutText}" Style="{StaticResource SubtitleTextStyle}"/>
                    <Button Grid.Column="1" Command="{Binding CopyCommand}" CommandParameter="{Binding ConvertOutputResult}" Style="{StaticResource MahApps.Styles.Button.WindowCommands}">
                        <TextBlock Text="&#xE8C8;" FontSize="14" FontFamily="Segoe MDL2 Assets"/>
                    </Button>
                </Grid>
                <TextBox Grid.Row="5" Text="{Binding ConvertOutputResult, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Grid.Row="6" Text="" Style="{StaticResource SubtitleTextStyle}"/>
                <TextBox Grid.Row="7" Text="{Binding ConvertComment, UpdateSourceTrigger=PropertyChanged}"/>
            </Grid>
        </Grid>
    </controls:MetroHeader>
</Page>
